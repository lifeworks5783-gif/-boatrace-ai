-6-2-3-5-4,1-2-4,1990,1,1,1,0,600,0\nlive_recovered_observation,20261011-23-10,唐津,6-1-3-2-4-5,1-2-3,650,2,0,1,0,600,0\nlive_recovered_observation,20261011-23-11,唐津,1-4-3-2-5-6,1-2-5,1300,1,1,1,0,600,0\nlive_recovered_observation,20261011-23-12,唐津,1-2-3-5-6-4,1-3-4,1890,1,1,1,0,600,0\n",
  "analysis_python": "import csv, json, re, itertools, hashlib\nfrom pathlib import Path\nfrom collections import defaultdict\np=Path(__file__).parent\nt=Path('/tmp/k261011.txt').read_text()\nresults={}\nfor v,b in re.findall(r'(\\d{2})KBGN(.*?)\\d{2}KEND',t,re.S):\n    for m in re.finditer(r'^\\s*(\\d+)R\\s+([1-6]-[1-6]-[1-6])\\s+(\\d+)\\s+([1-6]-[1-6]-[1-6])\\s+(\\d+)\\s+([1-6]-[1-6])\\s+(\\d+)',b,re.M):\n        race,tri,pay,_,_,exa,epay=m.groups()\n        id=f'20261011-{v}-{int(race):02}'\n        assert id not in results\n        results[id]=dict(race_id=id,venue_code=v,race=int(race),trifecta=tri,trifecta_pay=int(pay),exacta=exa,exacta_pay=int(epay))\nassert len(results)==156\nold=list(csv.DictReader((p/'oldresults.csv').open()))\nassert len(old)==120\nfor x in old:\n    y=results[x['race_id'].replace('_','-')]\n    assert x['trifecta']==y['trifecta'] and int(x['trifecta_pay'])==y['trifecta_pay']\nwith (p/'official_results_full.csv').open('w') as f:\n    w=csv.DictWriter(f,fieldnames=list(next(iter(results.values()))));w.writeheader();w.writerows(sorted(results.values(),key=lambda x:x['race_id']))\nreport={'date':'20261011','official_source':'https://www1.mbrace.or.jp/od2/K/202610/k261011.lzh','official_archive_sha256':hashlib.sha256(Path('/tmp/k261011.lzh').read_bytes()).hexdigest(),'official_results':156,'existing_results_crosschecked':120,'result_disagreements':0,'d1_writes':0}\ndetails=[]\nfor stage,file in [('morning','morning.csv'),('live_recovered_observation','live.csv')]:\n    groups=defaultdict(list)\n    for row in csv.DictReader((p/file).open()):groups[row['race_id']].append(row)\n    stage_rows=[]; invalid=[]\n    for id,rows in sorted(groups.items()):\n        if len(rows)!=6 or len({int(x['boat']) for x in rows})!=6 or sorted(int(x['rank']) for x in rows)!=list(range(1,7)):\n            invalid.append(id);continue\n        rank=sorted(rows,key=lambda x:int(x['rank']));boats=[int(x['boat']) for x in rank];r=results[id];actual=[int(x) for x in r['trifecta'].split('-')];winner_rank=boats.index(actual[0])+1\n        hit=set(boats[:3])==set(actual)\n        d=dict(stage=stage,race_id=id,venue_name=rows[0]['venue_name'],prediction='-'.join(map(str,boats)),actual=r['trifecta'],payout=r['trifecta_pay'],winner_rank=winner_rank,top1_hit=int(winner_rank==1),winner_in_top3=int(winner_rank<=3),box_hit=int(hit),box_investment=600,box_return=r['trifecta_pay'] if hit else 0)\n        stage_rows.append(d);details.append(d)\n    n=len(stage_rows);inv=600*n;ret=sum(x['box_return'] for x in stage_rows)\n    report[stage]={'valid_races':n,'invalid_races':invalid,'missing_races':sorted(set(results)-{x['race_id'] for x in stage_rows}),'top1_hits':sum(x['top1_hit'] for x in stage_rows),'winner_in_top2':sum(x['winner_rank']<=2 for x in stage_rows),'winner_in_top3':sum(x['winner_in_top3'] for x in stage_rows),'top3_box_hits':sum(x['box_hit'] for x in stage_rows),'box_investment':inv,'box_return':ret,'box_profit':ret-inv,'box_roi_percent':round(ret/inv*100,2),'venues':{}}\n    for v in sorted({x['venue_name'] for x in stage_rows}):\n        rr=[x for x in stage_rows if x['venue_name']==v]\n        report[stage]['venues'][v]={'races':len(rr),'top1_hits':sum(x['top1_hit'] for x in rr),'box_hits':sum(x['box_hit'] for x in rr),'box_roi_percent':round(sum(x['box_return'] for x in rr)/(600*len(rr))*100,2)}\nmorning={x['race_id']:x for x in details if x['stage']=='morning'}\nlive=[x for x in details if x['stage']=='live_recovered_observation']\nreport['paired_comparison']={'races':len(live),'winner_rank_improved':sum(x['winner_rank']<morning[x['race_id']]['winner_rank'] for x in live),'winner_rank_worsened':sum(x['winner_rank']>morning[x['race_id']]['winner_rank'] for x in live),'winner_rank_unchanged':sum(x['winner_rank']==morning[x['race_id']]['winner_rank'] for x in live)}\nreport['limitations']=['Live recovery records are retrospective observations, not proof of forecasts delivered before deadlines.','One live race with five boat records is excluded.','No new predictions or production collection were enabled.','BOX simulation assumes six combinations at 100 yen each; excludes refunds.']\n(p/'daily_summary_20261011.json').write_text(json.dumps(report,ensure_ascii=False,indent=2)+'\\n')\nwith (p/'daily_details_20261011.csv').open('w') as f:\n    w=csv.DictWriter(f,fieldnames=list(details[0]));w.writeheader();w.writerows(details)\nprint(json.dumps(report,ensure_ascii=False,indent=2))\n"
}
